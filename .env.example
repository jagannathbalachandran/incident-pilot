# Copy this file to .env and fill in your API key
GROQ_API_KEY=your_groq_api_key_here

# --- Model selection (optional) ---
# Defaults to llama-3.3-70b-versatile if unset (better reasoning, 100k
# tokens/day free-tier budget). Drop to llama-3.1-8b-instant if that daily
# quota is exhausted (weaker, but a separate budget, and only ~6000
# tokens/minute per request).
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Observability (Arize Phoenix) -- optional, off by default ---
# Set PHOENIX_TRACING=true to send each triage query to Phoenix as a grouped
# trace (token usage, latency, tool calls, RAG). When PHOENIX_TRACING is
# unset/false, tracing is fully disabled -- phoenix isn't even imported and
# nothing leaves the process.
#
# Phoenix needs NO Docker and NO API key: enabling tracing launches a
# lightweight server in-process (a background thread in this same Python
# process), serving its UI at http://localhost:6006. No separate server to
# start or manage.
#
# NOTE: enabling this sends prompts (retrieved runbook/postmortem text + live
# telemetry) and responses to wherever spans are exported -- by default
# that's the in-process server only.
# PHOENIX_TRACING=true
# PHOENIX_PROJECT_NAME=incident-pilot
# PHOENIX_COLLECTOR_ENDPOINT=                     # set to use an external/Phoenix Cloud instance instead
# PHOENIX_API_KEY=your_phoenix_cloud_key_here      # only for Phoenix Cloud
# PHOENIX_PORT=6006                                # local server port (default 6006)
