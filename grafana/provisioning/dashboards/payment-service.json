{
  "title": "payment-service",
  "version": 1,
  "timezone": "utc",
  "editable": true,
  "panels": [
    {
      "title": "Connections vs Max",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "svc_active_connections{service=\"payment-service\"}",
          "legendFormat": "active connections",
          "refId": "A"
        },
        {
          "expr": "svc_max_connections{service=\"payment-service\"}",
          "legendFormat": "max connections",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 200,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "orange", "value": 150},
              {"color": "red", "value": 190}
            ]
          }
        }
      },
      "options": {
        "legend": {"show": true, "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      }
    },
    {
      "title": "p99 Latency & Pool Timeout Errors",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "svc_p99_latency_ms{service=\"payment-service\"}",
          "legendFormat": "p99 latency (ms)",
          "refId": "A"
        },
        {
          "expr": "sum(rate(svc_errors_total{service=\"payment-service\", error_type=\"pool_timeout\"}[1m]))",
          "legendFormat": "pool timeouts / sec",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "orange", "value": 400},
              {"color": "red", "value": 700}
            ]
          }
        }
      },
      "options": {
        "legend": {"show": true, "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      }
    },
    {
      "title": "Error Rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "svc_error_rate_pct{service=\"payment-service\"}",
          "legendFormat": "error rate (%)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "orange", "value": 2},
              {"color": "red", "value": 5}
            ]
          }
        }
      }
    },
    {
      "title": "Pool Error Logs",
      "type": "logs",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {
          "expr": "{service=\"payment-service\"} |= \"could not obtain connection\"",
          "refId": "A"
        }
      ],
      "datasource": "Loki",
      "options": {
        "showLabels": false,
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogs": true
      }
    },
    {
      "title": "Cache Hit Ratio",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "targets": [
        {
          "expr": "svc_cache_hit_ratio{service=\"payment-service\"}",
          "legendFormat": "cache hit ratio",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "orange", "value": 0.85},
              {"color": "red", "value": 0.70}
            ]
          }
        }
      },
      "options": {
        "legend": {"show": true, "placement": "bottom"}
      }
    }
  ],
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {"from": "now-5m", "to": "now"}
}
